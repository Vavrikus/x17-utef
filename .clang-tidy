# Enable specific groups of checks
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  misc-*,
  -bugprone-easily-swappable-parameters,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-inconsistent-ifelse-braces,
  -readability-isolate-declaration,
  -readability-math-missing-parentheses,
  -readability-redundant-access-specifiers,
  -readability-redundant-member-init,
  -readability-redundant-parentheses,
  -readability-redundant-string-init,
  -misc-const-correctness,
  -modernize-avoid-c-arrays,
  -modernize-return-braced-init-list,
  -modernize-use-auto,
  -modernize-use-designated-initializers,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
#  -readability-function-cognitive-complexity,
#  -bugprone-implicit-widening-of-multiplication-result,
#  -bugprone-narrowing-conversions
# cppcoreguidelines-*
# ignoring bugprone-narrowing-conversions and readability-magic-numbers for now, but eventually should look at them
# 
CheckOptions:
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: true
  # Classes, Structs and Templates: RK4, Matrix (CamelCase)
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypedefCase
    value:           CamelCase
  # Public Methods: Integrate, GetResults (CamelCase, no underscore)
  - key:             readability-identifier-naming.MethodCase
    value:           CamelCase
  # Private/Protected Methods: StepInternal_, ResetSolver_ (CamelCase + Trailing Underscore)
  - key:             readability-identifier-naming.PrivateMethodCase
    value:           CamelCase
  - key:             readability-identifier-naming.PrivateMethodSuffix
    value:           _
  - key:             readability-identifier-naming.ProtectedMethodCase
    value:           CamelCase
  - key:             readability-identifier-naming.ProtectedMethodSuffix
    value:           _
  # Member Variables: m_dif_eq, m_results (m_ + lower_case)
  - key:             readability-identifier-naming.MemberCase
    value:           lower_case
  - key:             readability-identifier-naming.MemberPrefix
    value:           m_
  # Static Variables
  - key:             readability-identifier-naming.ClassMemberCase
    value:           lower_case
  - key:             readability-identifier-naming.ClassMemberPrefix
    value:           s_
  # Function Parameters: start, step_size (lower_case)
  # - key:             readability-identifier-naming.ParameterCase
  #   value:           lower_case
  # Local Variables: i, temp_val (lower_case)
  # - key:             readability-identifier-naming.LocalVariableCase
  #   value:           lower_case
  # Relax naming rules for the Struct name itself
  - key:             readability-identifier-naming.StructCase
    value:           aNy_CasE
  # Struct variables are evaluated as Public Members. 
  # This relaxes the rules so 'int x' is allowed without 'm_'
  - key:             readability-identifier-naming.PublicMemberCase
    value:           aNy_CasE
  - key:             readability-identifier-naming.PublicMemberPrefix
    value:           ''
  # Whitelist single-letter lowercase names strictly for public methods (e.g., x(), y() in structs)
  - key:             readability-identifier-naming.PublicMethodIgnoredRegexp
    value:           '^[a-z]$'
  # Allow implicit conversion of pointers to bool (e.g., if (ptr))
  - key:             readability-implicit-bool-conversion.AllowPointerConditions
    value:           'true'

# Treat some critical checks as actual compiler errors
WarningsAsErrors: >
  misc-include-cleaner
#   misc-*
#   bugprone-narrowing-conversions,
#   bugprone-sizeof-expression

# HeaderFilterRegex: '^.*/X17/*$'
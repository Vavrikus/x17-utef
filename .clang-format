# Formatting style for clang-format inspired by ROOT. 

# Basics:
#BasedOnStyle:  LLVM
Standard: c++17
IndentWidth: 2
TabWidth: 2
ColumnLimit: 120
PointerAlignment: Left
BreakBeforeBraces: Allman
UseTab: Never

# Alignments for better readability:
AccessModifierOffset: -2  # Don't indent access modifiers (public, private, protected).
AlignOperands: Align
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
AlignAfterOpenBracket: Align
AlignEscapedNewlines: LeftWithLastLine
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveBitFields: Consecutive
AlignConsecutiveDeclarations: None
ConstructorInitializerIndentWidth: 2
ContinuationIndentWidth: 2
Cpp11BracedListStyle: Block
IndentCaseLabels: true
IndentWrappedFunctionNames: true
NamespaceIndentation: All

# When are line breaks allowed:
AllowAllParametersOfDeclarationOnNextLine: true  # Don't force all parameters to be on a new line.
AllowShortBlocksOnASingleLine: Empty
AllowShortEnumsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline
  # Empty: true
  # Inline: true
  # Other: false
AlwaysBreakBeforeMultilineStrings: false
BreakAfterReturnType: ExceptShortType
BreakBeforeBinaryOperators: All
BreakBeforeTernaryOperators: true
BreakConstructorInitializers: BeforeColon
BreakTemplateDeclarations: Yes
BinPackArguments: true
# PackArguments:
  # BinPack: true
PackConstructorInitializers: NextLineOnly
BinPackParameters: true
# PackParameters:
#   BinPack: true
KeepEmptyLines:
  AtEndOfFile: false
  AtStartOfBlock: false
  AtStartOfFile: false
MaxEmptyLinesToKeep: 1
ReflowComments: Always
# Penalties for breaking lines:
PenaltyBreakBeforeFirstCallParameter: 19
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakString: 1000
PenaltyExcessCharacter: 1000000
PenaltyReturnTypeOnItsOwnLine: 100
# These would make debugging harder.
AllowShortCaseLabelsOnASingleLine: false
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false


# Spaces:
SpaceAfterCStyleCast: true
SpaceBeforeAssignmentOperators: true
SpaceBeforeCaseColon: false
SpaceBeforeParens: ControlStatements
SpacesBeforeTrailingComments: 1
SpacesInAngles: Never
SpacesInContainerLiterals: true
SpacesInParens: Never
SpacesInSquareBrackets: false

# Include sorting:
SortIncludes:
  Enabled: true
  IgnoreCase: true
  IgnoreExtension: true
IncludeBlocks: Regroup # Preserve

IncludeCategories:
  # 1. Standard C++ headers (e.g., <iostream>, <iomanip>)
  # Matches anything enclosed in angle brackets.
  - Regex:    '^<[a-zA-Z0-9_.]+>'
    Priority: 10
  # 2. ROOT Math dependencies (e.g., "Math/SMatrix.h")
  - Regex:    '^"Math/'
    Priority: 20
  # 3. General ROOT classes (e.g., "TVector3.h", "TFile.h")
  - Regex:    '^"T[^A-Z]'
    Priority: 30
  # 4. Everything else (e.g., your project's local headers like "ProjectOG.h")
  - Regex:    '.*'
    Priority: 40

# Other
CommentPragmas:  '^ IWYU pragma:' # Use this to prevent clang-format from reformatting.
ForEachMacros: [ foreach, Q_FOREACH, BOOST_FOREACH ]

# Order alphabetically and by generality the included header files.
# IncludeCategories:
  # - Regex:           '^"[^/]+\"'
  #   Priority:        10
  # - Regex:           '^("|<)T'
  #   Priority:        12
  # - Regex:           '^"ROOT/'
  #   Priority:        15
  # - Regex:           '^"cling/'
  #   Priority:        20
  # - Regex:           '^"clang/'
  #   Priority:        30
  # - Regex:           '^"llvm/'
  #   Priority:        40
  # - Regex:           '^<'
  #   Priority:        50
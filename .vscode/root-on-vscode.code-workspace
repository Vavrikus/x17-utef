{
	"folders": [
    {
      "name": "X17",
      "path": ".."
    }
  ],
  "settings": {
    "files.associations": {
      "*.shader": "glsl",
      "*.icc": "cpp",
      "plot_drift.C": "cpp",
      "bfield.C": "cpp",
      "cview_update.C": "cpp",
      "geometry.C": "cpp",
      "graph2d_overlay_test.C": "cpp",
      "c_track_xyz_0.C": "cpp",
      "*.inc": "cpp",
      ".clangd": "yaml",
      ".clang-format": "yaml",
      ".clang-tidy": "yaml"
    },
    "C_Cpp.default.includePath": [
      "${workspaceFolder}/include",
      "${ROOTSYS}/include",
      "${GARFIELD_INSTALL}/include"
